    "scene_location": "便利店临街窗边",
    "scene_time": "NIGHT",
    "scene_summary": "同一家便利店，同一暖色灯光。老陈隔着沾雨的玻璃望向空荡的街道，小夏站在一旁。窗外没有品牌标志和可读广告。用眼神与雨滴制造悬念。",
    "line_list": [
      {
        "line_no": 3,
        "character_name": "小夏",
        "line_text": "这么晚了，您到底在等谁？",
        "emotion": "NEUTRAL",
        "estimated_sec": 5
