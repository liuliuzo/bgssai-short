    ]
  },
  {
    "scene_no": 3,
    "scene_location": "便利店暖灯下",
    "scene_time": "NIGHT",
    "scene_summary": "小夏重新打开店内灯，给老陈倒一杯热水。老人捧杯的手与蒸汽特写，随后是小夏温和的侧脸；场景从冷雨反光转向暖黄色。",
    "line_list": [
      {
        "line_no": 5,
        "character_name": "老陈",
        "line_text": "她下班总是很晚，今天也一样。",
