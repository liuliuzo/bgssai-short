# 管理端（bgssai-short-drama-admin，8080，PLATFORM_ADMIN 控制面）test/prod 密钥模板。
# 用法：复制本文件到服务器 /opt/bgssai/bgssai-short-drama-admin/application-secrets.properties，
#       把每个 REPLACE_BEFORE_USE 改成真实值。该文件只存服务器、权限 600、绝不入库
#       （根 .gitignore 已排除真实文件名 application-secrets.properties）。
# 管理端与用户端连同一个库 bgssai_short_drama。dev 环境不需要本文件（走 application-dev.properties）。
# 注意：本文件内不得出现占位符表达式（Standards §1），直接写最终字面量。

# ---- 数据库（必填；与用户端同一个库 bgssai_short_drama）----
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/bgssai_short_drama?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
spring.datasource.username=REPLACE_BEFORE_USE
spring.datasource.password=REPLACE_BEFORE_USE

# ---- JWT（必填；openssl rand -base64 48 生成，>=32 字符，勿复用 dev/test 值）----
jwt.secret=REPLACE_BEFORE_USE_generate_random_min_32_chars
jwt.expiration-ms=86400000
