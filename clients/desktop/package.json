{
  "name": "bgssai-short-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "BGSSAI Short — single Electron shell with dual login entry (user / admin)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:local": "BGSSAI_CLIENT_ENV=local electron .",
    "start:dev": "BGSSAI_CLIENT_ENV=dev electron .",
    "start:prod": "BGSSAI_CLIENT_ENV=prod electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.bgssai.short.desktop",
    "productName": "BGSSAI Short",
    "artifactName": "BGSSAI-Short-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "entry/**",
      "config.js",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "BGSSAI Short"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
