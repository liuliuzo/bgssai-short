.shell {
  padding: 80rpx 48rpx 64rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(165deg, #0f172a 0%, #1e293b 36%, #f8fafc 36%);
}

.brand {
  font-size: 48rpx;
  font-weight: 700;
  color: #f8fafc;
  letter-spacing: 1rpx;
}

.lead {
  margin-top: 16rpx;
  margin-bottom: 72rpx;
  font-size: 28rpx;
  color: #cbd5e1;
}

.entrance {
  display: block;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 36rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  text-align: left;
  line-height: 1.4;
}

.entrance::after {
  border: none;
}

.role {
  font-size: 34rpx;
  font-weight: 650;
  color: #0f172a;
}

.desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #64748b;
}

.note {
  margin-top: 28rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}
