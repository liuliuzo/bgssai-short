.gate {
  min-height: 100vh;
  padding: 72rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 40rpx;
  box-sizing: border-box;
  background:
    radial-gradient(800rpx 400rpx at 10% 0%, #243554 0%, transparent 55%),
    linear-gradient(160deg, #0f1419, #1a2332);
}

.gate__brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 80rpx;
}

.gate__name {
  font-size: 56rpx;
  font-weight: 700;
  color: #f2f5f8;
}

.gate__sub {
  font-size: 28rpx;
  color: #9aa8b8;
}

.gate__entries {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

.entry {
  border: 1rpx solid rgba(242, 245, 248, 0.12);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  padding: 40rpx 32rpx;
}

.entry__label {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #f2f5f8;
}

.entry__hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa8b8;
  word-break: break-all;
}

.gate__meta {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa8b8;
}
