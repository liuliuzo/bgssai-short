{
  "expo": {
    "name": "BGSSAI Short",
    "slug": "bgssai-short",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1419"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bgssai.short"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1419"
      },
      "package": "com.bgssai.short"
    },
    "plugins": [],
    "extra": {
      "bgssaiEnv": "dev",
      "userUrlDev": "https://dev.user.bgssai-short.com",
      "adminUrlDev": "https://dev.admin.bgssai-short.com",
      "userUrlProd": "https://www.bgssai-short.com",
      "adminUrlProd": "https://admin.bgssai-short.com"
    }
  }
}
